{
  "//": "Copy to config.json and edit. config.json is gitignored: it holds your real model ids, absolute paths, and is read fresh on every settle.",
  "defaults": {
    "enabled": false,
    "autoConfirm": false,
    "judgeModel": "<provider>/<judge-model>",
    "judgeThinking": "low",
    "judgeTimeoutMs": 120000,
    "bootstrapTimeoutMs": 300000,
    "maxIterations": 300,
    "maxJudgeFailures": 2,
    "stagnationRounds": 3,
    "escalationTimeoutMs": 180000,
    "escalationMaxCalls": 3,
    "smartCompaction": true,
    "enforceReadTools": false,
    "escalationAgent": "escalation",
    "judgeFailover": true,
    "judgeFailoverModel": "<provider>/<fallback-model>",
    "stopFile": "~/.pi/agent/extensions/pi-supervisor/STOP",
    "logFile": "verdicts.jsonl",
    "judgeLogDir": "~/.pi/agent/extensions/pi-supervisor/judge-logs",
    "judgeStateDir": "~/.pi/agent/extensions/pi-supervisor/state",
    "judgeIndexDir": "~/.pi/agent/extensions/pi-supervisor/evidence-index",
    "judgeExtensions": [],
    "quotaWait": {
      "enabled": true,
      "intervalMs": 600000,
      "maxWaitMinutes": 0,
      "maxAttempts": 0,
      "permanentAsHumanNeeded": true,
      "extraPatterns": [],
      "ignorePatterns": []
    }
  },
  "projects": {
    "/abs/path/to/a/dedicated/unattended/worktree": {
      "enabled": true,
      "autoConfirm": true,
      "//": "Per-project keys override defaults shallowly. enabled:true bootstraps sessions without explicit supervision state; saved pause/cancel/completed states win. autoConfirm accepts only clear endpoints. Reserve this for dedicated unattended worktrees."
    }
  }
}
